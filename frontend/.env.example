# Copy to .env and fill in the values printed by `sam deploy` (see the root README).
# Vite only exposes variables starting with VITE_ to the browser. None of these
# are secrets: the API key never leaves the backend.

# API Gateway URL, without a trailing slash (stack output: ApiUrl)
VITE_API_BASE=https://abc123.execute-api.us-east-1.amazonaws.com/Prod

# Cognito hosted sign-in page (stack output: CognitoDomain)
VITE_COGNITO_DOMAIN=https://your-unique-prefix.auth.us-east-1.amazoncognito.com

# Cognito app client id (stack output: UserPoolClientId)
VITE_COGNITO_CLIENT_ID=
